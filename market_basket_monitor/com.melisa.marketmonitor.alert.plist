<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.melisa.marketmonitor.alert</string>

  <key>ProgramArguments</key>
  <array>
    <string>/path/to/market_basket_monitor/venv/bin/python3</string>
    <string>/path/to/market_basket_monitor/market_monitor.py</string>
    <string>--mode</string>
    <string>check</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/path/to/market_basket_monitor</string>

  <!-- Runs every 30 minutes -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <key>StandardOutPath</key>
  <string>/tmp/market_monitor_alert.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/market_monitor_alert.err</string>

  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
