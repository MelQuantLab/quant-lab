# Copy this file to .env and fill in your real credentials. Never commit .env.
#
# BT Internet often requires an app-specific password if you have extra security
# enabled on your BT ID. Generate one at: https://www.bt.com/help/email/email-security
BT_EMAIL_USER=your-email@example.com
BT_EMAIL_PASSWORD=your-app-password-here
EMAIL_FROM=your-email@example.com
EMAIL_TO=your-email@example.com
