<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.melquantlabs.marketmonitor.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/market_basket_monitor/venv/bin/python3</string>
    <string>/path/to/market_basket_monitor/run_daily_if_due.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/path/to/market_basket_monitor</string>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/tmp/melquantlabs_daily_ftse.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/melquantlabs_daily_ftse.err</string>
</dict>
</plist>
